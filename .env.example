# Local development only. Copy to .env and replace every placeholder.
# Never commit a real secret. AWS deployments use Secrets Manager, not this file.

APP_ENV=development

# Scenario constants. Do not derive these from the server clock.
CURRENT_TERM=Fall 2026
NEXT_TERM=Spring 2027

# Local storage and database
DATA_ROOT=./data
DATABASE_URL=sqlite:///./data/processed/app.db

# Auth: "local" for Docker Compose/local dev; "cognito" for AWS.
AUTH_PROVIDER=local
SESSION_SECRET=replace-me-local-only
CSRF_SECRET=replace-me-local-only

# Model providers (leave blank to run the deterministic offline adapter)
MODEL_PROVIDER=offline
MODEL_NAME=replace-me
EMBEDDING_MODEL=replace-me
VECTOR_DIMENSIONS=replace-with-model-dimension

# AWS / Cognito (populated after deploy; never place credentials here)
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=replace-with-account-id
AWS_ENVIRONMENT=dev
COGNITO_USER_POOL_ID=replace-after-deploy
COGNITO_CLIENT_ID=replace-after-deploy
S3_DOCUMENT_BUCKET=replace-after-deploy
