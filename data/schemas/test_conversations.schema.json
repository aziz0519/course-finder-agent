{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/test_conversations.schema.json",
  "title": "Canonical test conversations",
  "description": "Multi-turn regression script for the supplied student-001 scenario. The file is a test script, not academic evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_version",
    "provenance",
    "student_id",
    "scenario",
    "conversations"
  ],
  "properties": {
    "suite_version": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "student_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_term",
        "next_term"
      ],
      "properties": {
        "current_term": {
          "type": "string",
          "pattern": "^(Winter|Spring|Summer|Fall) [0-9]{4}$"
        },
        "next_term": {
          "type": "string",
          "pattern": "^(Winter|Spring|Summer|Fall) [0-9]{4}$"
        }
      }
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/tutorConversation"
          },
          {
            "$ref": "#/$defs/plannerConversation"
          }
        ]
      }
    }
  },
  "$defs": {
    "courseCode": {
      "type": "string",
      "pattern": "^[A-Z]{2,5} [0-9]{3}$"
    },
    "citationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_title",
        "pdf_page",
        "abstain_when_source_missing"
      ],
      "properties": {
        "document_title": {
          "type": "boolean"
        },
        "pdf_page": {
          "type": "boolean"
        },
        "abstain_when_source_missing": {
          "type": "boolean"
        }
      }
    },
    "tutorTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "user",
        "expected_course_code",
        "expected_document_title",
        "expected_source_filename",
        "response_requirements",
        "citation_requirements",
        "value_verification_status"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "expected_course_code": {
          "$ref": "#/$defs/courseCode"
        },
        "expected_document_title": {
          "type": "string",
          "minLength": 1
        },
        "expected_source_filename": {
          "type": "string",
          "minLength": 1
        },
        "response_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "citation_requirements": {
          "$ref": "#/$defs/citationRequirements"
        },
        "expected_answer_value": {
          "type": [
            "integer",
            "null"
          ]
        },
        "value_verification_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending_diagram_inspection",
            "verified_from_source"
          ]
        }
      }
    },
    "plannerTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "user",
        "request_unit_cap",
        "expected_recommended_courses",
        "expected_total_units",
        "expected_deferred_courses",
        "expected_alternative_courses",
        "expected_excluded_courses",
        "expected_catalogue_max_units",
        "response_requirements"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "request_unit_cap": {
          "type": "integer",
          "minimum": 1
        },
        "expected_recommended_courses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/courseCode"
          }
        },
        "expected_total_units": {
          "type": "integer",
          "minimum": 0
        },
        "expected_deferred_courses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/courseCode"
          }
        },
        "expected_alternative_courses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/courseCode"
          }
        },
        "expected_excluded_courses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/courseCode"
          }
        },
        "expected_catalogue_max_units": {
          "type": "integer",
          "minimum": 1
        },
        "response_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tutorConversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "kind",
        "description",
        "turns"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "const": "tutor"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "turns": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/tutorTurn"
          }
        }
      }
    },
    "plannerConversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "kind",
        "description",
        "turns"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "const": "planner"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "turns": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/plannerTurn"
          }
        }
      }
    }
  }
}
