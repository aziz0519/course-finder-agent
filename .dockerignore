# Keep the build context small and free of local state or secrets.
.git
.github
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
dist
build
cdk.out
.cdk.staging
cdk.context.json
.env
.env.*
!.env.example
e2e
infra
docs
node_modules
playwright-report
test-results

# Derived/local data. The supplied PDFs are intentionally not redistributed
# inside images; mount them for a local ingestion run.
data/processed/*
!data/processed/.gitkeep
data/incoming/*
!data/incoming/.gitkeep
data/samples/course-materials/*.pdf
